[configuration]

entry_symbol = "gdifc_library_init"
compatibility_minimum = "4.2"
reloadable = true

[icons]
GDIFCManager = "res://addons/GDIFC/assets/icons/building.svg"
IFCNode = "res://addons/GDIFC/assets/icons/box.svg"
IFCGeoreference = "res://addons/GDIFC/assets/icons/geo.svg"
IFCModel = "res://addons/GDIFC/assets/icons/model.svg"

[libraries]

linux.x86_64 = "res://addons/GDIFC/libgdifc.linux.template_release.x86_64.so"

windows.x86_64 = "res://addons/GDIFC/libgdifc.windows.template_release.x86_64.dll"

android.arm64 = "res://addons/GDIFC/libgdifc.android.template_release.arm64.so"

web.wasm32 = "res://addons/GDIFC/libgdifc.web.template_release.wasm32.wasm"

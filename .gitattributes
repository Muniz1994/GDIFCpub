# Normalize line endings
* text=auto eol=lf

# -----------------------------------------------------------------------
# Godot Asset Library export-ignore
#
# When a user installs GDIFC from the Asset Library (or downloads a zip),
# git archive is used to produce the archive.  Everything tagged
# export-ignore is excluded, leaving only addons/GDIFC/ (+ README/LICENCE).
#
# Asset Library submission: leave "Root directory" blank (use repo root).
# The addon will install at res://addons/GDIFC/ automatically.
# -----------------------------------------------------------------------

# C++ source & build system (not needed at runtime)
/GDIFC/                         export-ignore
/godot-cpp/                     export-ignore
/ifcparse/                      export-ignore
/web-ifc/                       export-ignore
/thirdparty/                    export-ignore
/tools/                         export-ignore
/images/                        export-ignore
/ifcopenshell-express/          export-ignore 

# Build & package config
/CMakeLists.txt                 export-ignore
/CMakeSettings.json             export-ignore
/SConstruct                     export-ignore
/vcpkg.json                     export-ignore
/vcpkg-configuration.json       export-ignore

# Test / demo Godot project (not part of the addon)
/ifc-godot-project/             export-ignore

# GitHub 
/.github/                       export-ignore
/.gitattributes                 export-ignore 
/.gitignore                     export-ignore 
/.gitmodules                    export-ignore        

# Main directory docs
/LICENCE
/README
